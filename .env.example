# Cloudflare R2 private research sharing
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=fl-studio-research-sessions
R2_ACCESS_KEY_ID=your-bucket-scoped-access-key-id
R2_SECRET_ACCESS_KEY=your-bucket-scoped-secret-access-key
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_REGION=auto

# Cloudflare permits presigned links for at most seven days (604800 seconds).
R2_SHARE_EXPIRY_SECONDS=604800
